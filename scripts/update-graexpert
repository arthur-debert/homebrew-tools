#!/usr/bin/env python3
import argparse
from pathlib import Path
import re
import tempfile

from astro_update import download, github_release, update_formula


def main():
    parser = argparse.ArgumentParser(description="Update GraXpert from Dark-Matters-Astro releases (latest stable by default). Requires curl and gh.")
    parser.add_argument("--version", help="Exact upstream tag, including prereleases, e.g. 4.0.0.rc1")
    parser.add_argument("--dry-run", action="store_true", help="Download and verify assets, then print the formula diff")
    args = parser.parse_args()
    release = github_release("Dark-Matters-Astro/GraXpert", args.version)
    version = release["tag_name"]
    if release["draft"] or not re.fullmatch(r"\d+\.\d+\.\d+(?:\.(?:rc|dev)\d+)?", version):
        raise ValueError(f"Unsupported release: {version}")
    assets = {}
    with tempfile.TemporaryDirectory(prefix="update-graxpert-") as directory:
        for arch, suffix in [("arm", "arm64"), ("intel", "x86_64")]:
            name = f"GraXpert-macos-{suffix}.dmg"
            asset, = [asset for asset in release["assets"] if asset["name"] == name]
            url = asset["browser_download_url"]
            sha256 = download(url, Path(directory) / name)
            if asset.get("digest") and asset["digest"] != f"sha256:{sha256}":
                raise ValueError(f"GitHub digest mismatch for {name}")
            assets[arch] = (url, sha256)
    update_formula("graxpert", version, assets, args.dry_run,
                   explicit_version=re.fullmatch(r"\d+\.\d+\.\d+", version) is None)


if __name__ == "__main__":
    main()
